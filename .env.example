POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=greenhill
POSTGRES_PASSWORD=greenhill

# Backs Sidekiq + Flipper (see config/initializers/sidekiq.rb and
# config/initializers/flipper.rb) — noeviction, so queued jobs and flag
# state never silently disappear under memory pressure.
SIDEKIQ_REDIS_URL=redis://localhost:6379/0

# Backs Rails.cache only (see config/environments/*.rb) — allkeys-lru, since
# cache data is disposable/recomputable.
CACHE_REDIS_URL=redis://localhost:6380/0

# Flipper's own Redis connection — defaults to the same instance as Sidekiq,
# kept as a separate var so it can move onto its own instance later.
FLIPPER_REDIS_URL=redis://localhost:6379/0

# Development mail delivery (see config/environments/development.rb) — points
# at Mailpit from docker-compose.yml; view caught mail at http://localhost:8025.
SMTP_ADDRESS=localhost
SMTP_PORT=1025
