{
  "name": "greenhill",
  "version": "0.0.1",
  "author": "Mark Rebec <mark@markrebec.com>",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "bin/rails s",
    "dev:client": "bin/vite dev",
    "dev:worker": "bundle exec sidekiq -C config/sidekiq.yml",
    "dev": "concurrently 'bun run dev:server' 'bun run dev:client' 'bun run dev:worker'",
    "build": "bin/vite build",
    "lint": "eslint src && bundle exec rubocop",
    "lint:fix": "eslint src --fix && bundle exec rubocop -A",
    "format": "prettier src -w",
    "test": "bun test && bundle exec rspec",
    "typecheck": "tsc --noEmit",
    "graphql:schema": "bundle exec rake graphql:schema:idl",
    "graphql:types": "bun run graphql:schema && graphql-codegen"
  },
  "dependencies": {
    "@apollo/client": "4.3.5",
    "@fontsource-variable/geist": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "axios": "1.21.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "graphql": "17.0.2",
    "lucide-react": "1.66.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-router": "8.5.1",
    "rxjs": "7.8.2",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/client-preset": "6.2.3",
    "@happy-dom/global-registrator": "21.0.4",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "prettier": "3.9.10",
    "shadcn": "4.23.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-ruby": "5.2.6"
  }
}
